    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#E0E0E0" />
        </shape>
    </item>
    <!-- Header area -->
    <item android:left="16dp" android:top="12dp" android:right="120dp" android:bottom="72dp">
        <shape android:shape="rectangle">
            <solid android:color="#CCCCCC" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Income area -->
    <item android:left="16dp" android:top="36dp" android:right="130dp" android:bottom="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CAF50" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Expense area -->
    <item android:left="130dp" android:top="36dp" android:right="16dp" android:bottom="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Balance area -->
    <item android:left="16dp" android:top="65dp" android:right="80dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#333333" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>